load(":defs.bzl", "gizlet_runtime")

package(default_visibility = ["//visibility:public"])

exports_files(["packages.lock.json"])

# Gizlet runtime 1: Debian trixie's glibc, Mesa and libdrm for launchers and
# apps on any arm64 device, independent of the read-only base. The card carries it as /opt/gizlet/runtime/1.sqfs on the data partition, mounted at
# /opt/gizlet/runtime/1 at boot; programs start through bin/gizlet-run.
gizlet_runtime(
    name = "gizlet-runtime-1",
    out = "gizlet-runtime-1.sqfs",
    debs = "@debian_trixie_arm64_runtime//:debs",
)
