#!/bin/sh
# gizlet-run PROGRAM [ARGUMENTS]: runs PROGRAM against this Gizlet runtime.
#
# The runtime's own glibc loader starts the program with the runtime's
# libraries, so it does not depend on the read-only base's glibc. EGL, GLES and
# GBM come from the runtime's Mesa: the GPU's driver where the kernel offers
# one (Panfrost on the R36S), llvmpipe on the CPU otherwise.
set -eu
runtime=$(CDPATH='' cd -P -- "$(dirname -- "$0")/.." && pwd -P)
export __EGL_VENDOR_LIBRARY_DIRS="$runtime/share/glvnd/egl_vendor.d"
export LIBGL_DRIVERS_PATH="$runtime/lib/dri"
export GBM_BACKENDS_PATH="$runtime/lib/gbm"
# Sound: raylib opens the runtime's libasound, which reads ALSA's
# configuration from the runtime rather than the base.
export ALSA_CONFIG_DIR="$runtime/share/alsa"
export ALSA_CONFIG_PATH="$runtime/share/alsa/alsa.conf"
# Media: GStreamer finds the runtime's plugins and loads them in the program's
# own process, since its plugin scanner would start without the runtime. GIO
# loads the runtime's TLS module, which trusts the base's CA certificates.
export GST_PLUGIN_SYSTEM_PATH_1_0="$runtime/lib/gstreamer-1.0"
export GST_REGISTRY_FORK=no
export GIO_MODULE_DIR="$runtime/lib/gio/modules"
[ $# -ge 1 ] || { echo 'usage: gizlet-run PROGRAM [ARGUMENTS]' >&2; exit 2; }
exec "$runtime/lib/ld-linux-aarch64.so.1" --library-path "$runtime/lib" "$@"
