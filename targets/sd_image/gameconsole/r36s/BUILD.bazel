load("//boards/gameconsole/r36s:card.bzl", "R36S_CARD", "R36S_DATA_UUID", "R36S_PANELS", "R36S_UBOOT_DTB_NAMES")
load("//rootfs:rootfs.bzl", "ROOTFS_DEBS", "ROOTFS_DIRECTORIES", "ROOTFS_DISABLE", "ROOTFS_ENABLE", "ROOTFS_EXECUTABLES", "ROOTFS_FILES", "ROOTFS_LICENSES", "ROOTFS_MASK", "ROOTFS_SUITE", "ROOTFS_SYMLINKS")
load("//tools/bazel/debian:defs.bzl", "debian_base")
load("//tests:defs.bzl", "gizlet_qemu_test", "gizlet_rootfs_test", "rockchip_card_test")
load("//tools/bazel/rockchip:defs.bzl", "rockchip_sd_image")

package(default_visibility = ["//visibility:public"])

_BOARD = "//boards/gameconsole/r36s:"

_EPOCH = 1704067200

_R36S = [_BOARD + "r36s"]

# The shared Debian base with the board's notices.
debian_base(
    name = "rootfs",
    out = "parts/rootfs.sqfs",
    debs = ROOTFS_DEBS,
    directories = ROOTFS_DIRECTORIES,
    disable = ROOTFS_DISABLE,
    enable = ROOTFS_ENABLE,
    executables = ROOTFS_EXECUTABLES,
    files = ROOTFS_FILES | {
        "@linux_firmware//:LICENCE.rtlwifi_firmware.txt": "usr/share/licenses/linux-firmware/LICENCE.rtlwifi_firmware.txt",
        "@rkbin//:LICENSE": "usr/share/licenses/rockchip-rkbin",
        "//third_party/linux:COPYING": "usr/share/licenses/linux/COPYING",
        "//third_party/linux:GPL-2.0": "usr/share/licenses/linux/LICENSES/preferred/GPL-2.0",
        "//third_party/linux:Linux-syscall-note": "usr/share/licenses/linux/LICENSES/exceptions/Linux-syscall-note",
        "//third_party/u-boot:README": "usr/share/licenses/u-boot/README",
        "//third_party/u-boot:gpl-2.0.txt": "usr/share/licenses/u-boot/gpl-2.0.txt",
    },
    mask = ROOTFS_MASK,
    source_date_epoch = _EPOCH,
    suite = ROOTFS_SUITE,
    symlinks = ROOTFS_SYMLINKS,
    target_compatible_with = _R36S,
)

# The card carries the R36S tree as r36s.dtb for boot.scr, and under every
# revision-dependent name the legacy U-Boot loads; see card.bzl.
[genrule(
    name = "uboot_" + dtb_name.removesuffix(".dtb"),
    srcs = [_BOARD + "r36s.dtb"],
    outs = ["parts/" + dtb_name],
    cmd = "cp $< $@",
    target_compatible_with = _R36S,
) for dtb_name in R36S_UBOOT_DTB_NAMES]

_CARD_FILES = {
    _BOARD + "idbloader.img": "idbloader.img",
    _BOARD + "uboot.img": "uboot.img",
    _BOARD + "trust.img": "trust.img",
    _BOARD + "boot.scr": "boot.scr",
    _BOARD + "Image": "Image",
    _BOARD + "r36s.dtb": "r36s.dtb",
    ":parts/rootfs.sqfs": "rootfs.sqfs",
    "//runtime:gizlet-runtime-1": "gizlet-runtime-1.sqfs",
} | {
    ":parts/" + dtb_name: dtb_name
    for dtb_name in R36S_UBOOT_DTB_NAMES
} | {
    _BOARD + "%s.dtbo" % panel: "%s.dtbo" % panel
    for panel in R36S_PANELS
}

# The R36S card. Its panel overlays sit beside the device tree; boot.scr
# applies the one copied to mipi-panel.dtbo.
rockchip_sd_image(
    name = "gizlet-os-r36s",
    out = "gizlet-os-r36s.img",
    inputs = _CARD_FILES,
    layout = _BOARD + "sdcard.cfg",
    layout_image = "sdcard.img",
    source_date_epoch = _EPOCH,
    target_compatible_with = _R36S,
)

# The card's former name. CI checks run main's .github/workflows/build.yml,
# which builds this label until this name change reaches main.
alias(
    name = "gizlet-os-r36s-panel0",
    actual = ":gizlet-os-r36s",
)

# The same card with a panel overlay already selected, for flashing a known unit.
[genrule(
    name = "sdcard_" + panel,
    srcs = [_BOARD + "sdcard.cfg"],
    outs = ["%s/sdcard.cfg" % panel],
    cmd = "sed 's/\"r36s.dtb\",/\"r36s.dtb\", \"mipi-panel.dtbo\",/' $< > $@ && grep -q mipi-panel.dtbo $@",
    target_compatible_with = _R36S,
) for panel in R36S_PANELS]

[rockchip_sd_image(
    name = "gizlet-os-" + panel,
    out = "gizlet-os-%s.img" % panel,
    inputs = _CARD_FILES | {":%s/mipi-panel.dtbo" % panel: "mipi-panel.dtbo"},
    layout = ":%s/sdcard.cfg" % panel,
    layout_image = "sdcard.img",
    source_date_epoch = _EPOCH,
    target_compatible_with = _R36S,
) for panel in R36S_PANELS]

[genrule(
    name = "mipi_panel_" + panel,
    srcs = [_BOARD + "%s.dtbo" % panel],
    outs = ["%s/mipi-panel.dtbo" % panel],
    cmd = "cp $< $@",
    target_compatible_with = _R36S,
) for panel in R36S_PANELS]

rockchip_card_test(
    name = "image_test",
    bl31 = _BOARD + "bl31",
    boot_command = _BOARD + "boot/boot.cmd",
    card = R36S_CARD,
    image = ":gizlet-os-r36s",
    tags = ["manual"],
    target_compatible_with = _R36S,
    trust_checksum = _BOARD + "boot/trust.sha256",
)

[rockchip_card_test(
    name = "image_test_" + panel.replace("-", "_"),
    bl31 = _BOARD + "bl31",
    boot_command = _BOARD + "boot/boot.cmd",
    card = card,
    image = ":gizlet-os-" + panel,
    tags = ["manual"],
    target_compatible_with = _R36S,
    trust_checksum = _BOARD + "boot/trust.sha256",
) for panel, card in R36S_PANELS.items()]

gizlet_rootfs_test(
    name = "rootfs_test",
    booter = "//session:booter",
    data_uuid = R36S_DATA_UUID,
    flash = _BOARD + "flash.sh",
    image = ":gizlet-os-r36s",
    licenses = ROOTFS_LICENSES + [
        "linux-firmware/LICENCE.rtlwifi_firmware.txt",
        "linux/COPYING",
        "linux/LICENSES/exceptions/Linux-syscall-note",
        "linux/LICENSES/preferred/GPL-2.0",
        "rockchip-rkbin",
        "u-boot/README",
        "u-boot/gpl-2.0.txt",
    ],
    tags = ["manual"],
    target_compatible_with = _R36S,
)

gizlet_qemu_test(
    name = "boot_test",
    size = "medium",
    flash = _BOARD + "flash.sh",
    image = ":gizlet-os-r36s",
    tags = ["manual"],
    target_compatible_with = _R36S,
)

# Release downloads for boards/gameconsole/r36s/flash.sh and flash.ps1: the
# compressed cards and their SHA256SUMS.
_RELEASE_IMAGES = ["gizlet-os-r36s"] + ["gizlet-os-" + panel for panel in R36S_PANELS]

[genrule(
    name = image + "_gz",
    srcs = [":" + image],
    outs = ["release/%s.img.gz" % image],
    cmd = "gzip -9 -n -c $< > $@",
    target_compatible_with = _R36S,
) for image in _RELEASE_IMAGES]

genrule(
    name = "release",
    srcs = [":%s_gz" % image for image in _RELEASE_IMAGES],
    outs = ["release/SHA256SUMS"],
    cmd = "for f in $(SRCS); do (cd $$(dirname $$f) && shasum -a 256 $$(basename $$f)); done > $@",
    target_compatible_with = _R36S,
)
