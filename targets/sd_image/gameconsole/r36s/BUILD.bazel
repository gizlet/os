load("//boards/gameconsole/r36s/rk3326:card.bzl", "R36S_CARD", "R36S_DATA_UUID", "R36S_PANELS", "R36S_UBOOT_DTB_NAMES")
load("//boot:defs.bzl", "gizlet_qemu_test", "gizlet_rootfs_test")
load("//tools/bazel/rockchip:defs.bzl", "busybox_squashfs", "rockchip_card_test", "rockchip_legacy_uboot", "rockchip_linux_kernel", "rockchip_sd_image")

package(default_visibility = ["//visibility:public"])

_BOARD = "//boards/gameconsole/r36s/rk3326:"

_EPOCH = 1704067200

_R36S = [_BOARD + "r36s"]

rockchip_linux_kernel(
    name = "kernel",
    archive = _BOARD + "linux_source",
    build_user = "gizlet",
    config = _BOARD + "kernel.config",
    dtb = "parts/r36s.dtb",
    dtb_target = "rockchip/gizlet-r36s.dtb",
    builtin_sources = {
        _BOARD + "panel_generic_dsi": "drivers/gpu/drm/panel/panel-generic-dsi.c",
        _BOARD + "joypad_driver": "drivers/input/joystick/rocknix-singleadc-joypad.c",
        _BOARD + "joypad_header": "drivers/input/joystick/rocknix-joypad.h",
    },
    dts_dirs = {_BOARD + "rocknix_dts": "rockchip"},
    dts_files = {
        _BOARD + "gizlet-r36s.dts": "rockchip/gizlet-r36s.dts",
        _BOARD + "r36s-v30-panel4.dtso": "rockchip/r36s-v30-panel4.dtso",
    },
    extra_dtb_targets = ["rockchip/r36s-v30-panel4.dtbo"],
    extra_dtbs = ["parts/r36s-v30-panel4.dtbo"],
    image = "parts/Image",
    # ROCKNIX applies this set with plain `patch -p1`, whose default fuzz is 2.
    patch_fuzz = 2,
    patches = [_BOARD + "kernel_patches"],
    source_date_epoch = _EPOCH,
    target_compatible_with = _R36S,
)

rockchip_legacy_uboot(
    name = "bootloader",
    archive = _BOARD + "uboot_source",
    bl31 = _BOARD + "bl31",
    boot_command = _BOARD + "boot.cmd",
    build_user = "gizlet",
    ddr = _BOARD + "ddr",
    defconfig = _BOARD + "uboot_defconfig",
    idbloader = "parts/idbloader.img",
    load_address = "0x00200000",
    miniloader = _BOARD + "miniloader",
    mkimage_soc = "px30",
    patches = [_BOARD + "uboot_patches"],
    script = "parts/boot.scr",
    script_name = "Gizlet R36S Panel 0",
    source_date_epoch = _EPOCH,
    target_compatible_with = _R36S,
    trust = "parts/trust.img",
    trust_checksum = _BOARD + "trust.sha256",
    trust_ini = _BOARD + "trust.ini",
    uboot = "parts/uboot.img",
)

busybox_squashfs(
    name = "rootfs",
    out = "parts/rootfs.sqfs",
    archive = _BOARD + "busybox_source",
    config = _BOARD + "busybox.config",
    directories = [
        "dev",
        "etc",
        "proc",
        "sys",
        "run",
        "tmp",
        "home",
        "opt/gizlet",
        "sbin",
        "usr/bin",
        "usr/sbin",
        "usr/share/licenses",
    ],
    executables = {
        _BOARD + "rcS": "etc/rcS",
        "//boot:boot-session": "sbin/boot-session",
        "//boot:save-boot-log": "sbin/save-boot-log",
        "//boot:debug-link": "sbin/debug-link",
        "//boot:usb-watch": "sbin/usb-watch",
        "//boot:gizlet-boot-device": "sbin/gizlet-boot-device",
        "//boot/dropbear:dropbear-bin": "usr/sbin/dropbear",
        "//boot/dropbear:dropbearkey-bin": "usr/bin/dropbearkey",
        "//boot/dropbear:scp-bin": "usr/bin/scp",
        "//boot:booter": "sbin/gizlet-booter",
    },
    files = {
        _BOARD + "inittab": "etc/inittab",
        "//boot:nsswitch.conf": "etc/nsswitch.conf",
        "//boot:passwd": "etc/passwd",
        "//boot:group": "etc/group",
        "//boot:shells": "etc/shells",
        "//boot:udhcpd.conf": "etc/udhcpd.conf",
        "//boot/dropbear:LICENSE": "usr/share/licenses/dropbear",
        _BOARD + "rkbin_license": "usr/share/licenses/rockchip-rkbin",
        "//third_party/linux:COPYING": "usr/share/licenses/linux/COPYING",
        "//third_party/linux:GPL-2.0": "usr/share/licenses/linux/LICENSES/preferred/GPL-2.0",
        "//third_party/linux:Linux-syscall-note": "usr/share/licenses/linux/LICENSES/exceptions/Linux-syscall-note",
        "//third_party/u-boot:README": "usr/share/licenses/u-boot/README",
        "//third_party/u-boot:gpl-2.0.txt": "usr/share/licenses/u-boot/gpl-2.0.txt",
        "//third_party/glibc:LGPL-2.1": "usr/share/licenses/glibc-LGPL-2.1",
    },
    source_date_epoch = _EPOCH,
    source_files = {"LICENSE": "usr/share/licenses/BusyBox"},
    target_compatible_with = _R36S,
)

# The card carries the R36S tree as r36s.dtb for boot.scr, and under every
# revision-dependent name the legacy U-Boot loads; see card.bzl.
[genrule(
    name = "uboot_" + dtb_name.removesuffix(".dtb"),
    srcs = [":parts/r36s.dtb"],
    outs = ["parts/" + dtb_name],
    cmd = "cp $< $@",
    target_compatible_with = _R36S,
) for dtb_name in R36S_UBOOT_DTB_NAMES]

_CARD_FILES = {
    ":parts/idbloader.img": "idbloader.img",
    ":parts/uboot.img": "uboot.img",
    ":parts/trust.img": "trust.img",
    ":parts/boot.scr": "boot.scr",
    ":parts/Image": "Image",
    ":parts/r36s.dtb": "r36s.dtb",
    ":parts/rootfs.sqfs": "rootfs.sqfs",
} | {
    ":parts/" + dtb_name: dtb_name
    for dtb_name in R36S_UBOOT_DTB_NAMES
} | {
    ":parts/%s.dtbo" % panel: "%s.dtbo" % panel
    for panel in R36S_PANELS
}

# The R36S card. Its panel overlays sit beside the device tree; boot.scr
# applies the one copied to mipi-panel.dtbo.
rockchip_sd_image(
    name = "gizlet-os-r36s",
    out = "gizlet-os-r36s.img",
    inputs = _CARD_FILES,
    layout = _BOARD + "sdcard.cfg",
    layout_image = "sdcard.img",
    source_date_epoch = _EPOCH,
    target_compatible_with = _R36S,
)

# The same card with a panel overlay already selected, for flashing a known unit.
[genrule(
    name = "sdcard_" + panel,
    srcs = [_BOARD + "sdcard.cfg"],
    outs = ["%s/sdcard.cfg" % panel],
    cmd = "sed 's/\"r36s.dtb\",/\"r36s.dtb\", \"mipi-panel.dtbo\",/' $< > $@ && grep -q mipi-panel.dtbo $@",
    target_compatible_with = _R36S,
) for panel in R36S_PANELS]

[rockchip_sd_image(
    name = "gizlet-os-" + panel,
    out = "gizlet-os-%s.img" % panel,
    inputs = _CARD_FILES | {":%s/mipi-panel.dtbo" % panel: "mipi-panel.dtbo"},
    layout = ":%s/sdcard.cfg" % panel,
    layout_image = "sdcard.img",
    source_date_epoch = _EPOCH,
    target_compatible_with = _R36S,
) for panel in R36S_PANELS]

[genrule(
    name = "mipi_panel_" + panel,
    srcs = [":parts/%s.dtbo" % panel],
    outs = ["%s/mipi-panel.dtbo" % panel],
    cmd = "cp $< $@",
    target_compatible_with = _R36S,
) for panel in R36S_PANELS]

rockchip_card_test(
    name = "image_test",
    bl31 = _BOARD + "bl31",
    boot_command = _BOARD + "boot.cmd",
    card = R36S_CARD,
    image = ":gizlet-os-r36s",
    tags = ["manual"],
    target_compatible_with = _R36S,
    trust_checksum = _BOARD + "trust.sha256",
)

[rockchip_card_test(
    name = "image_test_" + panel.replace("-", "_"),
    bl31 = _BOARD + "bl31",
    boot_command = _BOARD + "boot.cmd",
    card = card,
    image = ":gizlet-os-" + panel,
    tags = ["manual"],
    target_compatible_with = _R36S,
    trust_checksum = _BOARD + "trust.sha256",
) for panel, card in R36S_PANELS.items()]

gizlet_rootfs_test(
    name = "rootfs_test",
    booter = "//boot:booter",
    data_uuid = R36S_DATA_UUID,
    image = ":gizlet-os-r36s",
    licenses = [
        "BusyBox",
        "dropbear",
        "glibc-LGPL-2.1",
        "linux/COPYING",
        "linux/LICENSES/exceptions/Linux-syscall-note",
        "linux/LICENSES/preferred/GPL-2.0",
        "rockchip-rkbin",
        "u-boot/README",
        "u-boot/gpl-2.0.txt",
    ],
    tags = ["manual"],
    target_compatible_with = _R36S,
)

gizlet_qemu_test(
    name = "boot_test",
    size = "medium",
    image = ":gizlet-os-r36s",
    tags = ["manual"],
    target_compatible_with = _R36S,
)
