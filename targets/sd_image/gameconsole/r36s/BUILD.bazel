load("//boards/gameconsole/r36s/rk3326:card.bzl", "R36S_CARD", "R36S_DATA_UUID", "R36S_UBOOT_DTB_NAMES", "R36S_V30_PANEL4_CARD")
load("//boot:defs.bzl", "gizlet_qemu_test", "gizlet_rootfs_test")
load("//tools/bazel/rockchip:defs.bzl", "busybox_squashfs", "rockchip_card_test", "rockchip_legacy_uboot", "rockchip_linux_kernel", "rockchip_sd_image")

package(default_visibility = ["//visibility:public"])

_BOARD = "//boards/gameconsole/r36s/rk3326:"

_EPOCH = 1704067200

_PANEL0 = [_BOARD + "r36s_panel0"]

# Display variants of the R36S. Each card differs only in its device tree.
_VARIANTS = {
    "panel0": "parts/r36s.dtb",
    "v30-panel4": "parts/r36s-v30-panel4.dtb",
}

rockchip_linux_kernel(
    name = "kernel",
    archive = _BOARD + "linux_source",
    build_user = "gizlet",
    config = _BOARD + "kernel.config",
    dtb = "parts/r36s.dtb",
    dtb_target = "rockchip/gizlet-r36s-panel0.dtb",
    builtin_sources = {_BOARD + "panel_generic_dsi": "drivers/gpu/drm/panel/panel-generic-dsi.c"},
    dts_files = {
        _BOARD + "gizlet-r36s-panel0.dts": "rockchip/gizlet-r36s-panel0.dts",
        _BOARD + "gizlet-r36s-v30-panel4.dts": "rockchip/gizlet-r36s-v30-panel4.dts",
    },
    extra_dtb_targets = ["rockchip/gizlet-r36s-v30-panel4.dtb"],
    extra_dtbs = ["parts/r36s-v30-panel4.dtb"],
    image = "parts/Image",
    # ROCKNIX applies this set with plain `patch -p1`, whose default fuzz is 2.
    # 004-input-drivers needs it after 0006-rk817 shifts its trailing context.
    patch_fuzz = 2,
    patches = [_BOARD + "kernel_patches"],
    source_date_epoch = _EPOCH,
    target_compatible_with = _PANEL0,
)

rockchip_legacy_uboot(
    name = "bootloader",
    archive = _BOARD + "uboot_source",
    bl31 = _BOARD + "bl31",
    boot_command = _BOARD + "boot.cmd",
    build_user = "gizlet",
    ddr = _BOARD + "ddr",
    defconfig = _BOARD + "uboot_defconfig",
    idbloader = "parts/idbloader.img",
    load_address = "0x00200000",
    miniloader = _BOARD + "miniloader",
    mkimage_soc = "px30",
    patches = [_BOARD + "uboot_patches"],
    script = "parts/boot.scr",
    script_name = "Gizlet R36S Panel 0",
    source_date_epoch = _EPOCH,
    target_compatible_with = _PANEL0,
    trust = "parts/trust.img",
    trust_checksum = _BOARD + "trust.sha256",
    trust_ini = _BOARD + "trust.ini",
    uboot = "parts/uboot.img",
)

busybox_squashfs(
    name = "rootfs",
    out = "parts/rootfs.sqfs",
    archive = _BOARD + "busybox_source",
    config = _BOARD + "busybox.config",
    directories = [
        "dev",
        "etc",
        "proc",
        "sys",
        "run",
        "tmp",
        "home",
        "opt/gizlet",
        "sbin",
        "usr/share/licenses",
    ],
    executables = {
        _BOARD + "rcS": "etc/rcS",
        "//boot:boot-session": "sbin/boot-session",
        "//boot:save-boot-log": "sbin/save-boot-log",
        "//boot:booter": "sbin/gizlet-booter",
    },
    files = {
        _BOARD + "inittab": "etc/inittab",
        _BOARD + "rkbin_license": "usr/share/licenses/rockchip-rkbin",
        "//third_party/linux:COPYING": "usr/share/licenses/linux/COPYING",
        "//third_party/linux:GPL-2.0": "usr/share/licenses/linux/LICENSES/preferred/GPL-2.0",
        "//third_party/linux:Linux-syscall-note": "usr/share/licenses/linux/LICENSES/exceptions/Linux-syscall-note",
        "//third_party/u-boot:README": "usr/share/licenses/u-boot/README",
        "//third_party/u-boot:gpl-2.0.txt": "usr/share/licenses/u-boot/gpl-2.0.txt",
        "//third_party/glibc:LGPL-2.1": "usr/share/licenses/glibc-LGPL-2.1",
    },
    source_date_epoch = _EPOCH,
    source_files = {"LICENSE": "usr/share/licenses/BusyBox"},
    target_compatible_with = _PANEL0,
)

# Each card carries its variant's tree as r36s.dtb for boot.scr, and under every
# revision-dependent name the legacy U-Boot loads; see card.bzl.
[genrule(
    name = variant + "_" + dtb_name.removesuffix(".dtb"),
    srcs = [dtb],
    outs = [variant + "/" + dtb_name],
    cmd = "cp $< $@",
    target_compatible_with = _PANEL0,
) for variant, dtb in _VARIANTS.items() for dtb_name in ["r36s.dtb"] + R36S_UBOOT_DTB_NAMES]

[rockchip_sd_image(
    name = "gizlet-os-r36s-" + variant,
    out = "gizlet-os-r36s-%s.img" % variant,
    inputs = {
        ":parts/idbloader.img": "idbloader.img",
        ":parts/uboot.img": "uboot.img",
        ":parts/trust.img": "trust.img",
        ":parts/boot.scr": "boot.scr",
        ":parts/Image": "Image",
        ":parts/rootfs.sqfs": "rootfs.sqfs",
    } | {":%s/%s" % (variant, dtb_name): dtb_name for dtb_name in ["r36s.dtb"] + R36S_UBOOT_DTB_NAMES},
    layout = _BOARD + "sdcard.cfg",
    layout_image = "sdcard.img",
    source_date_epoch = _EPOCH,
    target_compatible_with = _PANEL0,
) for variant in _VARIANTS]

rockchip_card_test(
    name = "image_test",
    bl31 = _BOARD + "bl31",
    boot_command = _BOARD + "boot.cmd",
    card = R36S_CARD,
    image = ":gizlet-os-r36s-panel0",
    tags = ["manual"],
    target_compatible_with = _PANEL0,
    trust_checksum = _BOARD + "trust.sha256",
)

rockchip_card_test(
    name = "image_test_v30_panel4",
    bl31 = _BOARD + "bl31",
    boot_command = _BOARD + "boot.cmd",
    card = R36S_V30_PANEL4_CARD,
    image = ":gizlet-os-r36s-v30-panel4",
    tags = ["manual"],
    target_compatible_with = _PANEL0,
    trust_checksum = _BOARD + "trust.sha256",
)

gizlet_rootfs_test(
    name = "rootfs_test",
    booter = "//boot:booter",
    data_uuid = R36S_DATA_UUID,
    image = ":gizlet-os-r36s-panel0",
    licenses = [
        "BusyBox",
        "glibc-LGPL-2.1",
        "linux/COPYING",
        "linux/LICENSES/exceptions/Linux-syscall-note",
        "linux/LICENSES/preferred/GPL-2.0",
        "rockchip-rkbin",
        "u-boot/README",
        "u-boot/gpl-2.0.txt",
    ],
    tags = ["manual"],
    target_compatible_with = _PANEL0,
)

gizlet_qemu_test(
    name = "boot_test",
    size = "medium",
    image = ":gizlet-os-r36s-panel0",
    tags = ["manual"],
    target_compatible_with = _PANEL0,
)
