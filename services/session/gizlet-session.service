[Unit]
Description=Gizlet session: the boot.ini entry, then local recovery
After=gizlet-data.service systemd-user-sessions.service
# Leaving the recovery shell retries boot.ini, however often.
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/lib/gizlet/boot-session
Restart=always
RestartSec=0
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/console
TTYReset=yes
TTYVHangup=yes
Environment=TERM=linux
IgnoreSIGPIPE=no
SendSIGHUP=yes

[Install]
WantedBy=multi-user.target
