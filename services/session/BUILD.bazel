load("//devops/bazel/debian:defs.bzl", "debian_cc_binary")

package(default_visibility = ["//visibility:public"])

exports_files([
    "boot-session",
    "gizlet-session.service",
])

# The Booter starts the managed Launcher or the entry in /opt/gizlet/boot.ini. It runs from
# boot-session (rootfs/usr/lib/gizlet), which opens the recovery shell after it.
# Built with the build VM's Debian GCC as a static AArch64 glibc executable.
debian_cc_binary(
    name = "booter",
    srcs = ["booter.c"],
    copts = [
        "-std=c11",
        "-O2",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
)
