#!/bin/sh
# Run the configured entry on the console, then open a local recovery shell.
# Leaving the shell retries the entry with the same Launcher release.
export HOME=/home PATH=/usr/sbin:/usr/bin:/sbin:/bin
if [ -f /run/gizlet-data.ready ]; then
    # script keeps the entry on the console through a pty and copies what it
    # prints to /run/gizlet-session.log, which gizlet-late.log includes. Only
    # the first 256 KiB of each run is kept, as a diagnostic of how the entry
    # started: an app that logs for hours must not fill /run. The rest of the
    # copy is read and dropped, so script never blocks on it.
    log=/run/gizlet-session.log
    fifo=/run/gizlet-session.fifo
    rm -f "$fifo"
    mkfifo -m 0600 "$fifo"
    { head -c 262144 > "$log"; cat > /dev/null; } < "$fifo" &
    keeper=$!
    script -q -f -e -c /usr/lib/gizlet/gizlet-booter "$fifo"
    status=$?
    wait "$keeper" || :
    rm -f "$fifo"
    printf 'Gizlet OS: boot entry finished with status %d\n' "$status" | tee -a /run/gizlet-session.log
else
    echo 'Gizlet OS: data mounts unavailable'
fi
stty sane || :
printf 'Gizlet OS local recovery. Type exit to retry boot.ini.\n'
export PS1='recovery# ' INPUTRC=/usr/lib/gizlet/inputrc
exec /bin/bash --noprofile --norc -i
