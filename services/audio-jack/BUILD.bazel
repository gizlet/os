load("//devops/bazel/debian:defs.bzl", "debian_cc_binary")

package(default_visibility = ["//visibility:public"])

exports_files(["gizlet-audio-jack.service"])

# Routes sound to the speaker or the headphone jack, following the jack; run
# by gizlet-audio-jack.service. Static, like the Booter.
debian_cc_binary(
    name = "audio-jack",
    srcs = ["audio-jack.c"],
    copts = [
        "-std=c11",
        "-O2",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
)
