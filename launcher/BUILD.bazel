load(":defs.bzl", "gizlet_launcher")

package(default_visibility = ["//visibility:public"])

exports_files([
    "Cargo.lock",
    "build_card.sh",
] + glob(["fonts/*.txt"]))

# The Gizlet launcher for the card: home, settings and the button test. The
# card installs it as the boot entry of a fresh data partition (see
# rootfs/usr/lib/gizlet/boot-session). On a computer, `cargo run` in this
# directory opens it in a window.
gizlet_launcher(
    name = "gizlet-launcher",
    srcs = [
        "Cargo.lock",
        "Cargo.toml",
        "build.rs",
        "raylib-drm-scanout.patch",
    ] + glob([
        "fonts/**",
        "src/**",
    ]),
)
