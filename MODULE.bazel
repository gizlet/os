module(name = "gizlet_os")

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.28")
bazel_dep(name = "rules_rust", version = "0.75.0")
bazel_dep(name = "rules_shell", version = "0.10.0")

# Rust compiles the libkrun VM launcher for the build host.
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.100.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# libkrun and its guest kernel run the native image stages in a microVM.
krun = use_extension("//tools/bazel/krun:repositories.bzl", "krun_repositories")
use_repo(krun, "libkrun", "libkrunfw", "rust_std_aarch64_unknown_linux_musl")

# Debian bookworm arm64 tools for the build VM, pinned by snapshot and SHA-256.
debian = use_extension("//tools/bazel/debian:repositories.bzl", "debian")
use_repo(debian, "debian_bookworm_arm64")

# Pinned upstream sources, one repository per upstream. Boards select from them.
linux = use_extension("//third_party/linux:repositories.bzl", "linux")
use_repo(linux, "linux")

hardkernel_uboot = use_extension("//third_party/u-boot:repositories.bzl", "hardkernel_uboot")
use_repo(hardkernel_uboot, "hardkernel_uboot")

busybox = use_extension("//third_party/busybox:repositories.bzl", "busybox")
use_repo(busybox, "busybox")

rkbin = use_extension("//third_party/rkbin:repositories.bzl", "rkbin")
use_repo(rkbin, "rkbin")

rocknix = use_extension("//third_party/rocknix:repositories.bzl", "rocknix")
use_repo(rocknix, "rocknix")

rocknix_joypad = use_extension("//third_party/rocknix-joypad:repositories.bzl", "rocknix_joypad")
use_repo(rocknix_joypad, "rocknix_joypad")
