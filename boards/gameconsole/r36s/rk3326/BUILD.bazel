package(default_visibility = ["//visibility:public"])

constraint_setting(name = "board")

constraint_value(
    name = "r36s_panel0",
    constraint_setting = ":board",
)

platform(
    name = "panel0",
    constraint_values = [
        ":r36s_panel0",
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

exports_files([
    "boot.cmd",
    "busybox.config",
    "gizlet-r36s-panel0.dts",
    "inittab",
    "kernel.config",
    "rcS",
    "sdcard.cfg",
    "trust.ini",
    "trust.sha256",
])

# Upstream inputs this board builds from. Target packages reference only these.

_ROCKNIX_LINUX = "@rocknix//:projects/Rockchip/patches/linux/RK3326/"

_ROCKNIX_MAINLINE = "@rocknix//:packages/kernel/linux/patches/mainline/"

_ROCKNIX_UBOOT = "@rocknix//:projects/ROCKNIX/devices/RK3326/packages/u-boot-legacy/"

alias(
    name = "linux_source",
    actual = "@linux//:linux-6.12.17.tar.xz",
)

# Applied in this order with zero fuzz.
filegroup(
    name = "kernel_patches",
    srcs = [
        _ROCKNIX_MAINLINE + "0001-gpiolib-of-revert-api-changes-needed-for-joypad-driv.patch",
        _ROCKNIX_MAINLINE + "0002-input-add-input-polldev-driver.patch",
        _ROCKNIX_LINUX + "000-rk3326-dts.patch",
        _ROCKNIX_LINUX + "001-panel-updates.patch",
        _ROCKNIX_LINUX + "004-input-drivers.patch",
    ],
)

alias(
    name = "uboot_source",
    actual = "@hardkernel_uboot//:hardkernel-uboot-2492a3e467e332e2350d987234ce6123700b3392.tar.gz",
)

filegroup(
    name = "uboot_patches",
    srcs = [
        _ROCKNIX_UBOOT + "patches/01-fix-building.patch",
        "rk3326_trust.patch",
    ],
)

alias(
    name = "uboot_defconfig",
    actual = _ROCKNIX_UBOOT + "sources/configs/rocknix_rk3326_defconfig",
)

alias(
    name = "busybox_source",
    actual = "@busybox//:busybox-1.37.0.tar.bz2",
)

# Rockchip RK3326 legacy firmware: DDR 333 MHz v2.11, miniloader v1.40 and BL31 v1.34.
alias(
    name = "ddr",
    actual = "@rkbin//:bin/rk33/rk3326_ddr_333MHz_v2.11.bin",
)

alias(
    name = "miniloader",
    actual = "@rkbin//:bin/rk33/rk3326_miniloader_v1.40.bin",
)

alias(
    name = "bl31",
    actual = "@rkbin//:bin/rk33/rk3326_bl31_v1.34.elf",
)

alias(
    name = "rkbin_license",
    actual = "@rkbin//:LICENSE",
)
