package(default_visibility = ["//visibility:public"])

constraint_setting(name = "board")

constraint_value(
    name = "r36s_panel0",
    constraint_setting = ":board",
)

platform(
    name = "panel0",
    constraint_values = [
        ":r36s_panel0",
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

exports_files([
    "boot.cmd",
    "busybox.config",
    "gizlet-r36s-panel0.dts",
    "gizlet-r36s-v30-panel4.dts",
    "inittab",
    "kernel.config",
    "rcS",
    "sdcard.cfg",
    "trust.ini",
    "trust.sha256",
])

# Upstream inputs this board builds from. Target packages reference only these.

_ROCKNIX_LINUX = "@rocknix//:projects/Rockchip/patches/linux/RK3326/"

_ROCKNIX_MAINLINE = "@rocknix//:packages/kernel/linux/patches/mainline/"

_ROCKNIX_PANFROST = "@rocknix//:packages/kernel/linux/patches/panfrost/"

_ROCKNIX_ROCKCHIP = "@rocknix//:projects/Rockchip/patches/linux/mainline/"

_ROCKNIX_UBOOT = "@rocknix//:projects/ROCKNIX/devices/RK3326/packages/u-boot-legacy/"

alias(
    name = "linux_source",
    actual = "@linux//:linux-6.12.17.tar.xz",
)

# The RK3326 kernel patch set of ROCKNIX, in the order its build applies it
# (PKG_PATCH_DIRS "mainline RK3326 default panfrost": package patches first,
# then project patches; files sorted within each directory). The kernel target applies it with fuzz 2, as ROCKNIX does.
filegroup(
    name = "kernel_patches",
    srcs = [
        _ROCKNIX_MAINLINE + "0001-gpiolib-of-revert-api-changes-needed-for-joypad-driv.patch",
        _ROCKNIX_MAINLINE + "0002-input-add-input-polldev-driver.patch",
        _ROCKNIX_MAINLINE + "0003-pwm-add-pwm_set_period.patch",
        _ROCKNIX_MAINLINE + "0004-input-adc-keys-redirect-keycode-316-to-rocknix-joypa.patch",
        _ROCKNIX_MAINLINE + "0005-Bluetooth-btrtl-Add-the-support-for-RTL8733BU.patch",
        _ROCKNIX_MAINLINE + "0006-stable-rocknix-joypad-dtsi.patch",
        _ROCKNIX_PANFROST + "0005-drm-panfrost-Add-SYSTEM_TIMESTAMP-and-SYSTEM_TIMESTA.patch",
        _ROCKNIX_PANFROST + "0006-drm-panfrost-Add-cycle-counter-job-requirement.patch",
        _ROCKNIX_ROCKCHIP + "0005-rk817-stop-updating-info-in-suspend.patch",
        _ROCKNIX_ROCKCHIP + "0006-rk817-update-battery-capacity-calibration.patch",
        _ROCKNIX_LINUX + "000-rk3326-dts.patch",
        _ROCKNIX_LINUX + "001-panel-updates.patch",
        _ROCKNIX_LINUX + "003-dmc-driver.patch",
        _ROCKNIX_LINUX + "004-input-drivers.patch",
        _ROCKNIX_LINUX + "005-unigue-gpio-guid.patch",
        _ROCKNIX_LINUX + "006-powkiddy-rgb10x.patch",
        _ROCKNIX_LINUX + "007-ogs-panel-timings.patch",
        _ROCKNIX_LINUX + "020-elida-refresh-rates.patch",
        _ROCKNIX_LINUX + "021-magicx-xu-mini-m.patch",
        _ROCKNIX_LINUX + "022-usb-role-switch.patch",
        _ROCKNIX_LINUX + "023-gameconsole-r36max.patch",
    ],
)

# ROCKNIX's panel driver that takes the init sequence from the device tree.
alias(
    name = "panel_generic_dsi",
    actual = "@rocknix//:packages/kernel/drivers/generic-dsi/sources/panel-generic-dsi.c",
)

alias(
    name = "uboot_source",
    actual = "@hardkernel_uboot//:hardkernel-uboot-2492a3e467e332e2350d987234ce6123700b3392.tar.gz",
)

filegroup(
    name = "uboot_patches",
    srcs = [
        _ROCKNIX_UBOOT + "patches/01-fix-building.patch",
        "rk3326_trust.patch",
    ],
)

alias(
    name = "uboot_defconfig",
    actual = _ROCKNIX_UBOOT + "sources/configs/rocknix_rk3326_defconfig",
)

alias(
    name = "busybox_source",
    actual = "@busybox//:busybox-1.37.0.tar.bz2",
)

# Rockchip RK3326 legacy firmware: DDR 333 MHz v2.11, miniloader v1.40 and BL31 v1.34.
alias(
    name = "ddr",
    actual = "@rkbin//:bin/rk33/rk3326_ddr_333MHz_v2.11.bin",
)

alias(
    name = "miniloader",
    actual = "@rkbin//:bin/rk33/rk3326_miniloader_v1.40.bin",
)

alias(
    name = "bl31",
    actual = "@rkbin//:bin/rk33/rk3326_bl31_v1.34.elf",
)

alias(
    name = "rkbin_license",
    actual = "@rkbin//:LICENSE",
)
