/*
 * Gizlet OS on the Game Console R36S. ROCKNIX's device tree describes the
 * board with the original ST7703 panel; other panels are device tree
 * overlays applied by boot.scr (see r36s-v30-panel4.dtso).
 */
#include "rk3326-gameconsole-r36s.dts"

/*
 * For now the OTG port is a USB device: a computer connected to it sees a
 * serial console and a network link (g_cdc) for ssh until WiFi works. The port
 * must not source VBUS while the computer powers it, so OTG_SWITCH stays off
 * and the controller has no supply. It returns to host mode afterwards.
 */
&otg_switch {
	/delete-property/ regulator-boot-on;
};

&u2phy_otg {
	status = "okay";
};

&usb20_otg {
	dr_mode = "peripheral";
	/delete-property/ vbus-supply;
};

/*
 * The host-port PHY is already enabled upstream. Its EHCI/OHCI controllers
 * expose USB devices wired to that port, such as an on-board WiFi module.
 */
&usb_host0_ehci {
	status = "okay";
};

&usb_host0_ohci {
	status = "okay";
};
