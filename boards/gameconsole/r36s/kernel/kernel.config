# Required boot, console and input drivers are built in; olddefconfig fills defaults.
CONFIG_LOCALVERSION="-gizlet-r36s"
# CONFIG_LOCALVERSION_AUTO is not set
# gizlet-late.log includes the regulator summary from debugfs.
CONFIG_DEBUG_FS=y
CONFIG_ARCH_ROCKCHIP=y
CONFIG_SMP=y
CONFIG_BLK_DEV=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_FUTEX=y
CONFIG_ELF_CORE=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLOCK=y
CONFIG_MSDOS_PARTITION=y
# Networking for WiFi and ssh.
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XATTR=y
# Gizlet runtimes are SquashFS files on the data partition, mounted through loop devices.
CONFIG_BLK_DEV_LOOP=y
# systemd on the Debian base: cgroups, namespaces, seccomp, autofs, and an
# overlay for the writable /var.
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CPUSETS=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_OVERLAY_FS=y
CONFIG_IPV6=y
CONFIG_KEYS=y
# iwd needs rfkill (it exits without /dev/rfkill) and uses the kernel's crypto
# through AF_ALG and keyctl.
CONFIG_RFKILL=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_MD4=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_DES=y
CONFIG_EXT4_FS=y
# The boot partition receives gizlet.log.
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
# The TF2 card, often exFAT, holds the user's own files (gizlet-tf2).
CONFIG_EXFAT_FS=y
CONFIG_NLS_UTF8=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_PINCTRL_ROCKCHIP=y
CONFIG_GPIO_ROCKCHIP=y
CONFIG_PWM=y
CONFIG_PWM_ROCKCHIP=y
CONFIG_I2C=y
CONFIG_I2C_RK3X=y
CONFIG_MFD_RK8XX_I2C=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_RK808=y
CONFIG_ROCKCHIP_PM_DOMAINS=y
CONFIG_ROCKCHIP_IOMMU=y
CONFIG_ROCKCHIP_IODOMAIN=y
CONFIG_THERMAL=y
CONFIG_ROCKCHIP_THERMAL=y
# CPU frequency scaling along the tree's OPP table (up to 1.416 GHz) with
# vdd_arm from the RK817. schedutil follows the load; performance and
# userspace allow a fixed clock through sysfs, and the thermal zone can
# throttle the clock.
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPUFREQ_DT=y
CONFIG_CPUFREQ_DT_PLATDEV=y
CONFIG_CPU_THERMAL=y
# Idle cores and the cluster power down through PSCI (the tree's cpu-sleep and
# cluster-sleep states) instead of spinning in WFI, as in ROCKNIX. Without the
# periodic tick they stay down between frames, and the menu governor picks the
# state from the next timer.
CONFIG_NO_HZ_IDLE=y
CONFIG_CPU_IDLE=y
CONFIG_CPU_IDLE_GOV_MENU=y
CONFIG_ARM_PSCI_CPUIDLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_DRM=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_VOP=y
CONFIG_ROCKCHIP_DW_MIPI_DSI=y
CONFIG_PHY_ROCKCHIP_INNO_DSIDPHY=y
CONFIG_DRM_PANEL_SITRONIX_ST7703=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# The Mali-G31 GPU (Bifrost, no firmware) for the Gizlet runtime's Mesa.
# Panfrost scales its clock along the tree's OPP table with devfreq.
CONFIG_DRM_PANFROST=y
CONFIG_PM_DEVFREQ=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
CONFIG_PM_OPP=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_POLLDEV=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_IIO=y
CONFIG_ROCKCHIP_SARADC=y
CONFIG_KEYBOARD_GPIO=y
# The rocknix-singleadc-joypad driver reports BTN_MODE through adc-keys and
# drives rumble through the memless force-feedback helper.
CONFIG_KEYBOARD_ADC=y
CONFIG_INPUT_FF_MEMLESS=y
# Sleep: suspend to RAM (gizlet-power), woken by the RK817's power key, which
# also reports KEY_POWER.
CONFIG_SUSPEND=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_RK805_PWRKEY=y
# Sound: the tree's rk817-sound card, the RK817's codec on I2S1 for the
# speaker and the headphone jack, fed by the PL330 DMA controller. USB audio
# devices work too.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_ROCKCHIP_I2S=y
CONFIG_SND_SOC_RK817=y
CONFIG_SND_SIMPLE_CARD=y
CONFIG_SND_USB_AUDIO=y
CONFIG_DMADEVICES=y
CONFIG_PL330_DMA=y
# The battery: the RK817's fuel gauge and charger, with the tree's
# monitored-battery (its capacity and OCV table), at /sys/class/power_supply.
CONFIG_POWER_SUPPLY=y
CONFIG_CHARGER_RK817=y
# The RK817's real-time clock: the time survives power off and sets the
# system clock at boot, before the network corrects it.
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_RK808=y
CONFIG_USB=y
CONFIG_USB_DWC2=y
# The OTG port is a USB host (see gizlet-r36s.dts).
CONFIG_USB_DWC2_HOST=y
CONFIG_EXTCON=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
# Standard USB Bluetooth controllers (class E0/01/01) on the OTG port, driven by
# btusb and exposed by BlueZ. LE is on; olddefconfig keeps BR/EDR for dual-mode
# dongles. BlueZ's HID-over-GATT plugin creates LE keyboards and gamepads
# through uhid.
CONFIG_BT=y
CONFIG_BT_LE=y
CONFIG_BT_HCIBTUSB=y
CONFIG_UHID=y
# On-board RTL8188EU or RTL8188FU WiFi. Its firmware is built into the kernel, because the
# device can probe before the root filesystem is mounted.
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_RTL8XXXU=y
CONFIG_EXTRA_FIRMWARE="rtlwifi/rtl8188eufw.bin rtlwifi/rtl8188fufw.bin"
CONFIG_EXTRA_FIRMWARE_DIR="firmware"
# ARM virt smoke boot of the same Image and partitioned card.
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
