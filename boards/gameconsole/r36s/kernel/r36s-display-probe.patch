@@ -1326,6 +1331,20 @@
  */
 int dw_mipi_dsi_bind(struct dw_mipi_dsi *dsi, struct drm_encoder *encoder)
 {
+	static const struct drm_display_mode probe_mode = {
+		DRM_MODE("640x480", 0, 58870, 640, 940, 1142, 1442, 0,
+			 480, 497, 509, 522, 0, 0),
+	};
+
+	if (dsi->probe_panel && !dsi->master && !dsi->slave) {
+		dw_mipi_dsi_mode_set(dsi, &probe_mode);
+		gizlet_r36s_detect_panel(dsi->probe_panel);
+		dw_mipi_dsi_bridge_post_atomic_disable(&dsi->bridge, NULL);
+		dsi->lanes = dsi->probe_panel->lanes;
+		dsi->format = dsi->probe_panel->format;
+		dsi->mode_flags = dsi->probe_panel->mode_flags;
+	}
+
 	return drm_bridge_attach(encoder, &dsi->bridge, NULL, 0);
 }
 EXPORT_SYMBOL_GPL(dw_mipi_dsi_bind);
