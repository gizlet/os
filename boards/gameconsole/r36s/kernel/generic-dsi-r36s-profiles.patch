+static void gizlet_select_panel_profile(struct mipi_dsi_device *dsi, const u8 *id, size_t len)
+{
+    struct generic_panel *ctx = mipi_dsi_get_drvdata(dsi);
+    struct device_node *profiles __free(device_node) =
+        of_get_child_by_name(dsi->dev.of_node, "panel-profiles");
+
+    if (!profiles)
+        return;
+
+    for_each_available_child_of_node_scoped(profiles, profile) {
+        struct generic_panel alternate = { .profile = profile };
+        unsigned long mode_flags = dsi->mode_flags;
+        enum mipi_dsi_pixel_format format = dsi->format;
+        unsigned int lanes = dsi->lanes;
+        const u8 *match;
+        int match_len;
+
+        match = of_get_property(profile, "gizlet,display-ids", &match_len);
+        if (!match || match_len < len || match_len % len)
+            continue;
+        while (match_len && memcmp(id, match, len)) {
+            match += len;
+            match_len -= len;
+        }
+        if (!match_len)
+            continue;
+
+        if (load_panel_description(dsi, &alternate) || !alternate.modes || !alternate.iseq) {
+            dsi->mode_flags = mode_flags;
+            dsi->format = format;
+            dsi->lanes = lanes;
+            dev_warn(ctx->dev, "invalid panel profile %pOF\n", profile);
+            return;
+        }
+
+        ctx->profile_selected = true;
+        ctx->modes = alternate.modes;
+        ctx->iseq = alternate.iseq;
+        ctx->size = alternate.size;
+        ctx->delays = alternate.delays;
+        dev_info(ctx->dev, "display ID %*ph matched %pOFn\n", (int)len, id, profile);
+        return;
+    }
+}
+
+void gizlet_r36s_detect_panel(struct mipi_dsi_device *dsi)
+{
+    struct generic_panel *ctx = mipi_dsi_get_drvdata(dsi);
+    u8 id[3] = {};
+    int ret;
+
+    if (*descfile || ctx->profile_selected)
+        return;
+
+    gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+    ret = regulator_enable(ctx->vdd);
+    if (ret)
+        return;
+    ret = regulator_enable(ctx->iovcc);
+    if (ret)
+        goto disable_vdd;
+
+    if (ctx->enable_gpio)
+        gpiod_set_value_cansleep(ctx->enable_gpio, 1);
+    msleep(20);
+    gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+    msleep(20);
+
+    ret = mipi_dsi_set_maximum_return_packet_size(dsi, sizeof(id));
+    if (!ret)
+        ret = mipi_dsi_dcs_read(dsi, MIPI_DCS_GET_DISPLAY_ID, id, sizeof(id));
+
+    gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+    if (ctx->enable_gpio)
+        gpiod_set_value_cansleep(ctx->enable_gpio, 0);
+    regulator_disable(ctx->iovcc);
+
+    if (ret == sizeof(id))
+        gizlet_select_panel_profile(dsi, id, sizeof(id));
+    if (!ctx->profile_selected)
+        dev_info(ctx->dev, "display ID %3ph (%d), using default profile\n", id, ret);
+
+disable_vdd:
+    regulator_disable(ctx->vdd);
 }
 
