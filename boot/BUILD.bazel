load("//tools/bazel/debian:defs.bzl", "debian_cc_binary")

exports_files([
    "boot-session",
    "card.py",
    "qemu_test.py",
    "rootfs_test.py",
    "gizlet-boot-device",
    "gizlet-net",
    "group",
    "nsswitch.conf",
    "passwd",
    "save-boot-log",
    "shells",
    "udhcpc.script",
])

# Built with the build VM's Debian GCC as a static AArch64 glibc executable,
# like BusyBox, so the card needs no further C library notices.
debian_cc_binary(
    name = "booter",
    srcs = ["booter.c"],
    copts = [
        "-std=c11",
        "-O2",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    visibility = ["//targets:__subpackages__"],
)
