#!/bin/sh
# Diagnoses the USB device port. For 10 s it records VBUS detection, PHY
# suspend and UDC state every 2 s. If the PHY never saw VBUS, it takes the
# OTG PHY out of suspend and watches 60 s more, to tell a missing VBUS
# detection apart from a link that never forms. Each sample is shown on the
# LCD, and gizlet-usb.log on the FAT boot partition is rewritten after each
# phase. Register fields follow the kernel's phy-rockchip-inno-usb2.c
# (rk3328_phy_cfgs, also used by PX30/RK3326).
export PATH=/sbin:/bin:/usr/sbin:/usr/bin
grf=0xff2c0000
log=/run/gizlet-usb.log
: > "$log"

say() {
    echo "$*" >> "$log"
    echo "usb: $*" > /dev/tty1 2>/dev/null
}

sample() {
    read -r up _ < /proc/uptime
    sus=$(devmem $((grf + 0x100)) 32 2>&1)
    st=$(devmem $((grf + 0x120)) 32 2>&1)
    case "$st" in
        0x*) say "t=$up con0=$sus st=$st bvalid=$(( (st >> 9) & 1 )) avalid=$(( (st >> 10) & 1 )) id=$(( (st >> 6) & 1 )) ls=$(( (st >> 4) & 3 )) udc=$(cat /sys/class/udc/*/state 2>/dev/null)" ;;
        *) say "t=$up devmem failed: $st" ;;
    esac
}

save() {
    boot_dev=$(/sbin/gizlet-boot-device) || return 0
    dir=/run/gizlet-usbfs
    mkdir -p "$dir"
    mount -t vfat -o rw,nodev,nosuid,noexec,flush "$boot_dev" "$dir" || return 0
    cp "$log" "$dir/gizlet-usb.log.new" && mv "$dir/gizlet-usb.log.new" "$dir/gizlet-usb.log"
    sync
    umount "$dir"
}

say '== observe'
seen=0
i=0
while [ $i -lt 5 ]; do
    sample
    case "$(tail -n 1 "$log")" in *bvalid=1*) seen=1 ;; esac
    i=$((i + 1)); sleep 2
done
save
if [ $seen = 0 ]; then
    say '== no VBUS seen, forcing the OTG PHY out of suspend'
    devmem $((grf + 0x100)) 32 0xffff0000
    i=0
    while [ $i -lt 30 ]; do
        sample
        i=$((i + 1)); sleep 2
    done
fi
say '== done'
dmesg | grep -i -E 'usb|dwc2|gadget|phy|cdc' | tail -n 40 >> "$log"
save
