#!/bin/sh
# Diagnoses the USB device port. For 30 s it records VBUS detection, PHY
# suspend and UDC state every 2 s. If the PHY never saw VBUS, it takes the
# OTG PHY out of suspend and watches 60 s more, to tell a missing VBUS
# detection apart from a link that never forms. The result is gizlet-usb.log
# on the FAT boot partition. Register fields follow the kernel's
# phy-rockchip-inno-usb2.c (rk3328_phy_cfgs, also used by PX30/RK3326).
export PATH=/sbin:/bin:/usr/sbin:/usr/bin
grf=0xff2c0000
log=/run/gizlet-usb.log

sample() {
    sus=$(devmem $((grf + 0x100)) 32)
    st=$(devmem $((grf + 0x120)) 32)
    read -r up _ < /proc/uptime
    echo "t=$up phy_con0=$sus utmi_status=$st bvalid=$(( (st >> 9) & 1 )) avalid=$(( (st >> 10) & 1 )) id=$(( (st >> 6) & 1 )) linestate=$(( (st >> 4) & 3 )) udc=$(cat /sys/class/udc/*/state 2>/dev/null) usb0=$(cat /sys/class/net/usb0/carrier 2>/dev/null)"
}

{
    echo '== usb-watch: observe'
    seen=0
    i=0
    while [ $i -lt 15 ]; do
        line=$(sample); echo "$line"
        case "$line" in *bvalid=1*) seen=1 ;; esac
        i=$((i + 1)); sleep 2
    done
    if [ $seen = 0 ]; then
        echo '== usb-watch: no VBUS seen, forcing the OTG PHY out of suspend'
        devmem $((grf + 0x100)) 32 0xffff0000
        i=0
        while [ $i -lt 30 ]; do
            sample
            i=$((i + 1)); sleep 2
        done
    fi
    echo '== dmesg (usb)'
    dmesg | grep -i -E 'usb|dwc2|gadget|phy|cdc' | tail -40
} > "$log" 2>&1

boot_dev=$(/sbin/gizlet-boot-device) || exit 0
dir=/run/gizlet-usbfs
mkdir -p "$dir"
mount -t vfat -o rw,nodev,nosuid,noexec,flush "$boot_dev" "$dir" || exit 0
cp "$log" "$dir/gizlet-usb.log.new" && mv "$dir/gizlet-usb.log.new" "$dir/gizlet-usb.log"
sync
umount "$dir"
