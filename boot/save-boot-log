#!/bin/sh
# Keep this boot's kernel log on the FAT boot partition (partition 1 of the
# system disk) as gizlet.log, so a card can be diagnosed on any computer
# without a serial cable. Failure here never stops the boot.
export PATH=/sbin:/bin:/usr/sbin:/usr/bin
boot_dev=$(/sbin/gizlet-boot-device)
[ -b "$boot_dev" ] || { echo 'Gizlet OS: boot partition missing, no gizlet.log'; exit 0; }
dir=/run/gizlet-bootfs
mkdir -p "$dir"

# Runs SECTION_FUNCTION into FILE on the mounted boot partition.
write_log() {
    mount -t vfat -o rw,nodev,nosuid,noexec,flush "$boot_dev" "$dir" || { echo 'Gizlet OS: cannot mount boot partition, no gizlet.log'; return 0; }
    "$1" > "$dir/$2.new" 2>&1
    mv "$dir/$2.new" "$dir/$2"
    sync
    umount "$dir"
}

boot_state() {
    echo '== Gizlet OS boot log'
    uname -a
    cat /proc/cmdline
    echo '== rcS'
    cat /run/gizlet-boot.log 2>/dev/null
    [ -f /run/gizlet-data.ready ] && echo 'data mounts ready' || echo 'data mounts unavailable'
    echo '== display and input'
    for f in /sys/class/drm/*/status /sys/class/drm/*/enabled /sys/class/backlight/*/brightness /sys/class/backlight/*/bl_power; do
        [ -e "$f" ] && echo "$f: $(cat "$f")"
    done
    ls /dev/input
    echo '== dmesg'
    dmesg
}

# Devices that take a while to appear, such as USB keyboards, show up here.
late_state() {
    echo '== Gizlet OS state 15 s after boot'
    echo '== input devices'
    cat /proc/bus/input/devices
    echo '== usb devices'
    for d in /sys/bus/usb/devices/*; do
        [ -e "$d/idVendor" ] || continue
        echo "${d##*/}: $(cat "$d/idVendor"):$(cat "$d/idProduct") speed=$(cat "$d/speed") $(cat "$d/manufacturer" 2>/dev/null) $(cat "$d/product" 2>/dev/null)"
    done
    echo '== regulators'
    for r in /sys/class/regulator/regulator.*; do
        echo "$(cat "$r/name"): state=$(cat "$r/state" 2>/dev/null) uV=$(cat "$r/microvolts" 2>/dev/null) users=$(cat "$r/num_users" 2>/dev/null)"
    done
    echo '== usb device port'
    for f in /sys/class/udc/*/state /sys/class/udc/*/current_speed; do
        [ -e "$f" ] && echo "$f: $(cat "$f")"
    done
    ip addr 2>&1
    echo '== usb-watch so far'
    cat /run/gizlet-usb.log 2>/dev/null
    cat /run/udhcpd.leases 2>/dev/null | hexdump -C | head -n 4
    if mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null || [ -d /sys/kernel/debug/regulator ]; then
        echo '== regulator summary'
        cat /sys/kernel/debug/regulator/regulator_summary 2>/dev/null
    fi
    echo '== dmesg'
    dmesg
}

write_log boot_state gizlet.log
( sleep 15; write_log late_state gizlet-late.log; : > /run/gizlet-late.done ) &
exit 0
