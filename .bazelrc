# Build the Booter for the same static AArch64 Linux ABI as the base system.
build:r36s-common --extra_toolchains=@zig_sdk//toolchain:linux_arm64_musl
build:r36s --features=fully_static_link
build:r36s-common --extra_toolchains=@gizos//tools/bazel/platforms:linux_arm64_test_toolchain,@gizos//tools/bazel/platforms:linux_x86_64_test_toolchain
build:r36s-common --workspace_status_command=tools/r36s/build_status.sh

build:r36s --config=r36s-common
build:r36s --platforms=//boards/gameconsole/r36s/rk3326:panel0

build:r36s-v30 --config=r36s-common
build:r36s-v30 --platforms=//boards/gameconsole/r36s/v30_panel4:panel4
