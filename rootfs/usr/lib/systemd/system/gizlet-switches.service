[Unit]
Description=Start the services turned on in the launcher (Wi-Fi, ssh)
After=gizlet-data.service
Requires=gizlet-data.service
ConditionPathExists=/run/gizlet-data.ready

[Service]
Type=oneshot
# setup.ini on the boot partition can join Wi-Fi and turn ssh on first.
ExecStartPre=-/usr/lib/gizlet/gizlet-setup
ExecStart=/usr/lib/gizlet/gizlet-switch boot

[Install]
WantedBy=multi-user.target
