[Unit]
Description=Route sound to the speaker or the headphones, following the jack
# The control and its items are the R36S's RK817 codec's.
After=sound.target
ConditionPathExists=/proc/asound/card0

[Service]
ExecStart=/usr/lib/gizlet/gizlet-audio-jack "Playback Mux" HP SPK
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
