#!/bin/sh
# save-boot-log boot|late: keep this boot's state and kernel log on the FAT
# boot partition (partition 1 of the system disk) as gizlet.log, and again
# 15 s later as gizlet-late.log, so a card can be diagnosed on any computer
# without a serial cable. Failure here never stops the boot.
boot_dev=$(/usr/lib/gizlet/gizlet-boot-device)
[ -b "$boot_dev" ] || { echo 'Gizlet OS: boot partition missing, no gizlet.log'; exit 0; }
dir=/run/gizlet-bootfs
mkdir -p "$dir"

# Mounts of the boot partition take this lock (see gizlet-mount-boot).
# Runs SECTION_FUNCTION into FILE on the mounted boot partition.
write_log() {
    (
        flock 9
        /usr/lib/gizlet/gizlet-mount-boot "$dir" rw || { echo 'Gizlet OS: cannot mount boot partition, no gizlet.log'; exit 0; }
        "$1" > "$dir/$2.new" 2>&1
        mv "$dir/$2.new" "$dir/$2"
        sync
        umount "$dir"
    ) 9> /run/gizlet-bootfs.lock
}

boot_state() {
    echo '== Gizlet OS boot log'
    uname -a
    cat /proc/cmdline
    echo '== Gizlet OS services'
    cat /run/gizlet-boot.log 2>/dev/null
    systemctl --failed --no-pager --plain 2>&1
    [ -f /run/gizlet-data.ready ] && echo 'data mounts ready' || echo 'data mounts unavailable'
    echo '== display and input'
    for f in /sys/class/drm/*/status /sys/class/drm/*/enabled /sys/class/backlight/*/brightness /sys/class/backlight/*/bl_power; do
        [ -e "$f" ] && echo "$f: $(cat "$f")"
    done
    ls /dev/input
    echo '== dmesg'
    dmesg
}

# Devices that take a while to appear, such as USB keyboards, show up here.
late_state() {
    echo '== Gizlet OS state 15 s after boot'
    echo '== input devices'
    cat /proc/bus/input/devices
    echo '== usb devices'
    for d in /sys/bus/usb/devices/*; do
        [ -e "$d/idVendor" ] || continue
        echo "${d##*/}: $(cat "$d/idVendor"):$(cat "$d/idProduct") speed=$(cat "$d/speed") $(cat "$d/manufacturer" 2>/dev/null) $(cat "$d/product" 2>/dev/null)"
    done
    echo '== regulators'
    for r in /sys/class/regulator/regulator.*; do
        echo "$(cat "$r/name"): state=$(cat "$r/state" 2>/dev/null) uV=$(cat "$r/microvolts" 2>/dev/null) users=$(cat "$r/num_users" 2>/dev/null)"
    done
    echo '== network'
    ip addr 2>&1
    echo '== failed units'
    systemctl --failed --no-pager --plain 2>&1
    echo '== Gizlet OS services'
    cat /run/gizlet-boot.log 2>/dev/null
    echo '== boot partition check'
    cat /run/gizlet-bootfs.fsck 2>/dev/null
    echo '== session output'
    cat /run/gizlet-session.log 2>/dev/null
    echo '== processes'
    ps -eo pid,stat,etime,args 2>&1
    echo '== display devices'
    ls -l /dev/dri 2>&1
    echo '== ssh'
    ls -l /run/gizlet-ssh 2>&1
    mountpoint /etc/shadow 2>&1
    echo '== unit logs'
    journalctl -b --no-pager -o short-monotonic -u gizlet-session -u gizlet-switches -u gizlet-ssh -u ssh -u iwd 2>&1 | tail -n 80
    if mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null || [ -d /sys/kernel/debug/regulator ]; then
        echo '== regulator summary'
        cat /sys/kernel/debug/regulator/regulator_summary 2>/dev/null
    fi
    echo '== dmesg'
    dmesg
}

case "${1:-}" in
    boot) write_log boot_state gizlet.log ;;
    late) write_log late_state gizlet-late.log; : > /run/gizlet-late.done ;;
    *) echo 'usage: save-boot-log boot|late' >&2; exit 2 ;;
esac
exit 0
