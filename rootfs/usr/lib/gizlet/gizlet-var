#!/bin/sh
# /var on the read-only base: the image's /var below, a tmpfs above, so
# services can write their state. gizlet-mount-data binds what must persist.
set -eu
mkdir -p /run/gizlet-var/upper /run/gizlet-var/work
mount -t overlay overlay -o lowerdir=/var,upperdir=/run/gizlet-var/upper,workdir=/run/gizlet-var/work /var
