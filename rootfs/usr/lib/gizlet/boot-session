#!/bin/sh
# gizlet-session.service runs this on the console: the boot.ini entry, the
# launcher by default, then a local recovery shell. Leaving the shell starts
# the session again.
export HOME=/home PATH=/usr/sbin:/usr/bin:/sbin:/bin
factory=/usr/lib/gizlet/gizlet-launcher
start=/usr/lib/gizlet/gizlet-launcher-start
cli=/usr/lib/gizlet/gizlet-cli
launcher_dir=/opt/gizlet/launcher
# The factory launcher and CLI are installed together when boot.ini is absent
# or selects the factory entry. Card updates bring a new copy of both.
replace_executable() {
    local pending
    pending=$(mktemp "$2.XXXXXX") || return 1
    if install -m 0755 "$1" "$pending" && mv -fT "$pending" "$2"; then
        return 0
    fi
    rm -f "$pending"
    return 1
}
install_launcher() {
    mkdir -p "$launcher_dir/bin" &&
        replace_executable "$cli" "$launcher_dir/bin/cli" &&
        replace_executable "$start" "$launcher_dir/gizlet-launcher" &&
        replace_executable "$factory" "$launcher_dir/bin/gizlet-launcher"
}
# Check file type before cmp, which would block on a FIFO.
same_file() { [ -f "$2" ] && [ ! -L "$2" ] && [ -x "$2" ] && cmp -s "$1" "$2"; }
launcher_current() {
    same_file "$cli" "$launcher_dir/bin/cli" &&
        same_file "$factory" "$launcher_dir/bin/gizlet-launcher" &&
        same_file "$start" "$launcher_dir/gizlet-launcher"
}
if [ -f /run/gizlet-data.ready ] && [ -x "$factory" ] && [ -x "$start" ] && [ -x "$cli" ]; then
    if [ ! -e /opt/gizlet/boot.ini ]; then
        install_launcher &&
            printf '%s\n' '[boot]' 'entry=launcher/gizlet-launcher' > /opt/gizlet/boot.ini.new &&
            mv /opt/gizlet/boot.ini.new /opt/gizlet/boot.ini && sync &&
            echo 'Gizlet OS: installed the factory launcher as the boot entry'
    # Only a boot.ini the Booter would read: a regular file, not a link, at most
    # 4 KiB (a FIFO would block here). The Booter drops a line's trailing CR, so
    # a boot.ini saved on Windows counts too.
    elif [ -f /opt/gizlet/boot.ini ] && [ ! -L /opt/gizlet/boot.ini ] &&
        [ "$(wc -c < /opt/gizlet/boot.ini)" -le 4096 ] &&
        sed 's/\r$//' /opt/gizlet/boot.ini | grep -qx 'entry=launcher/gizlet-launcher' &&
        ! launcher_current; then
        install_launcher && sync && echo 'Gizlet OS: updated the factory launcher'
    fi
fi
if [ -f /run/gizlet-data.ready ]; then
    # script keeps the entry on the console through a pty and copies what it
    # prints to /run/gizlet-session.log, which gizlet-late.log includes. Only
    # the first 256 KiB of each run is kept, as a diagnostic of how the entry
    # started: an app that logs for hours must not fill /run. The rest of the
    # copy is read and dropped, so script never blocks on it.
    log=/run/gizlet-session.log
    fifo=/run/gizlet-session.fifo
    rm -f "$fifo"
    mkfifo -m 0600 "$fifo"
    { head -c 262144 > "$log"; cat > /dev/null; } < "$fifo" &
    keeper=$!
    script -q -f -e -c /usr/lib/gizlet/gizlet-booter "$fifo"
    status=$?
    wait "$keeper" || :
    rm -f "$fifo"
    printf 'Gizlet OS: boot entry finished with status %d\n' "$status" | tee -a /run/gizlet-session.log
else
    echo 'Gizlet OS: data mounts unavailable'
fi
stty sane || :
printf 'Gizlet OS local recovery. Type exit to retry boot.ini.\n'
export PS1='recovery# ' INPUTRC=/usr/lib/gizlet/inputrc
exec /bin/bash --noprofile --norc -i
