#!/bin/sh
# Mounts the data partition at /data: ext4 partition 3 of the very disk that
# supplied the read-only base (partition 2), with the image's filesystem UUID.
# device/ holds what every profile shares: the installed packages, runtimes,
# Launcher releases and the device's settings (ssh host key, Wi-Fi networks,
# Bluetooth pairings, switches) under settings/. profiles/<id>/ holds each
# local profile. The profile device/boot-profile names, or else the oldest,
# or else a new one, is mounted at /run/gizlet/profile and its home/ at
# /home, and its ID written to /run/gizlet/profile.id.
#
# The image's data filesystem is small. The card writers (flash.sh, flash.ps1)
# extend its partition to the end of the card and grow the filesystem to fill
# it, so their cards boot as on any later boot. A card written another way has
# its partition extended here, as long as it is the last partition, and on
# first boot the filesystem is then grown to it before it is mounted.
set -eu
# The boot waits for this script, and until the mount it shares the card with
# udev and the other early services. Every program it starts must first be
# read from the SquashFS root, so it reads sysfs with the shell's own read and
# the ext4 superblock with od: blkid and dumpe2fs took most of its time.
# save-boot-log copies these messages to the boot partition.
say() { echo "Gizlet OS: $*"; echo "$*" >> /run/gizlet-boot.log; }
# Seconds since boot after each step, logged at exit.
steps=
step() { read -r up idle < /proc/uptime; steps="$steps $1=$up"; }
trap 'status=$?; echo "gizlet-mount-data steps:$steps" >> /run/gizlet-boot.log
      echo "gizlet-mount-data exit $status" >> /run/gizlet-boot.log' EXIT
step start
# attr FILE: sets a to the first line of FILE, or to nothing without it.
attr() { a=; [ -r "$1" ] && read -r a < "$1" || :; }

# Locate partition 3 on the very disk that supplied the mounted SquashFS (p2).
root_device=
while read -r id parent device fsroot target rest; do
    if [ "$target" = / ]; then root_device=$device; break; fi
done < /proc/self/mountinfo
cd -P "/sys/dev/block/$root_device"
sysroot=$PWD
cd /
attr "$sysroot/partition"
[ "$a" = 2 ] || { say 'unexpected system partition'; exit 1; }
data_dev=
for sibling in "${sysroot%/*}"/*; do
    attr "$sibling/partition"
    if [ "$a" = 3 ]; then
        data_dev=/dev/${sibling##*/}
        break
    fi
done
[ -b "$data_dev" ] || { say 'data partition missing'; exit 1; }
# The ext4 superblock starts 1024 bytes in. Little-endian fields: the block
# count at 0x04 (cards stay far below the 2^32 blocks that need its high
# half), the block size as 1024 << the value at 0x18, the magic ef53 at 0x38
# and the UUID at 0x68.
blocks= log_block= magic= uuid= i=0
for byte in $(od -An -v -tx1 -j 1024 -N 120 "$data_dev"); do
    case $i in
        [4-7]) blocks=$byte$blocks ;;
        2[4-7]) log_block=$byte$log_block ;;
        5[67]) magic=$byte$magic ;;
        10[4-9] | 11[0-9])
            uuid=$uuid$byte
            case $i in 107 | 109 | 111 | 113) uuid=$uuid- ;; esac
            ;;
    esac
    i=$((i + 1))
done
if [ "$magic" != ef53 ] || [ "$uuid" != cef58f4f-a7a3-40ac-9cb3-bd8d89aab65f ]; then
    say 'unexpected data filesystem'
    exit 1
fi
fs_bytes=$(( 0x$blocks << (10 + 0x$log_block) ))
step identified
# Grow partition 3 in the MBR when the card has unused space after it.
disk_sys=${sysroot%/*}
disk=/dev/${disk_sys##*/}
part_sys=/sys/class/block/${data_dev##*/}
attr "$part_sys/start"; start=$a
attr "$part_sys/size"; end=$((start + a))
attr "$disk_sys/size"; total=$a
last=yes
for sibling in "$disk_sys"/*; do
    [ -f "$sibling/start" ] || continue
    attr "$sibling/start"
    [ "$a" -gt "$start" ] && last=
done
if [ "$last" = yes ] && [ $((total - end)) -gt 2048 ]; then
    if echo ', +' | sfdisk -q -N 3 --no-reread --no-tell-kernel "$disk" && partx -u --nr 3 "$disk"; then
        attr "$part_sys/size"
        say "data partition grown to $(( (a * 512) >> 20 )) MiB"
    else
        say 'cannot grow the data partition'
    fi
fi
# Grow the filesystem to its partition while it is unmounted: resize2fs then
# leaves the new inode tables unwritten (they are marked unused), where the
# kernel's online resize would write zeros over all of them.
attr "$part_sys/size"
if [ $(( a * 512 - fs_bytes )) -gt 1048576 ]; then
    # resize2fs wants a freshly checked filesystem; 0 and 1 mean clean or repaired.
    status=0
    e2fsck -fp "$data_dev" > /dev/null 2>&1 || status=$?
    if [ "$status" -le 1 ] && resize2fs "$data_dev" > /dev/null 2>&1; then
        say "data filesystem grown to fill its partition"
    else
        say 'cannot grow the data filesystem'
    fi
    step grown
fi
store=/data
# noinit_itable: the kernel would otherwise zero the inode tables of a grown
# filesystem in the background, tens of seconds of SD card writes on the first
# boot that stall everything else, the launcher's install among them. The
# group checksums already mark those tables unused, so they need no zeroing.
mount -t ext4 -o rw,nodev,nosuid,noinit_itable "$data_dev" "$store"
step mounted
# mount(8) can fall back to read-only mode when the card is write protected.
writable=
while read -r id parent device fsroot target opts rest; do
    if [ "$target" = "$store" ]; then
        case ,$opts, in *,rw,*) writable=yes ;; esac
    fi
done < /proc/self/mountinfo
if [ "$writable" != yes ]; then
    say 'writable data partition required'
    umount "$store"
    exit 1
fi
for directory in device profiles; do
    if [ ! -d "$store/$directory" ] || [ -L "$store/$directory" ]; then
        say "invalid data directory $directory"
        umount "$store"
        exit 1
    fi
done
device=$store/device
settings=$device/settings
# These directories exist after the first boot, so mkdir need not start then.
[ -d "$settings/ssh" ] && [ -d "$settings/iwd" ] && [ -d "$settings/bluetooth" ] ||
    mkdir -p -m 0700 "$settings/ssh" "$settings/iwd" "$settings/bluetooth"
[ -d /var/lib/iwd ] && [ -d /var/lib/bluetooth ] || mkdir -p /var/lib/iwd /var/lib/bluetooth
mount -o bind "$settings/iwd" /var/lib/iwd
mount -o bind "$settings/bluetooth" /var/lib/bluetooth

# The profile. An ID is 16 lowercase hexadecimal digits (launcher/src/profiles.rs).
profiles=$store/profiles
valid_profile() {
    case $1 in
        '' | *[!0-9a-f]*) return 1 ;;
        ????????????????) ;;
        *) return 1 ;;
    esac
    [ -d "$profiles/$1" ] && [ ! -L "$profiles/$1" ] && [ -f "$profiles/$1/profile.ini" ]
}
profile=
[ -f "$device/boot-profile" ] && read -r profile < "$device/boot-profile" || :
if ! valid_profile "$profile"; then
    [ -z "$profile" ] || say "the profile $profile is missing"
    profile= oldest=
    for dir in "$profiles"/*; do
        valid_profile "${dir##*/}" || continue
        created=0
        while IFS='= ' read -r key value; do
            [ "$key" = created ] && case $value in '' | *[!0-9]*) ;; *) created=$value ;; esac
        done < "$dir/profile.ini"
        if [ -z "$profile" ] || [ "$created" -lt "$oldest" ]; then
            profile=${dir##*/} oldest=$created
        fi
    done
    if [ -z "$profile" ]; then
        IFS=- read -r a b c rest < /proc/sys/kernel/random/uuid
        profile=$a$b$c
        new=$profiles/.new-$profile
        mkdir -p "$new/launcher" "$new/apps" "$new/services" "$new/home"
        printf 'name = \ncreated = 0\n' > "$new/profile.ini"
        mv "$new" "$profiles/$profile"
        say "created the profile $profile"
    fi
    printf '%s\n' "$profile" > "$device/boot-profile.new"
    mv -f "$device/boot-profile.new" "$device/boot-profile"
    sync -f "$device"
fi
current=$profiles/$profile
for directory in launcher apps services home; do
    [ -d "$current/$directory" ] || mkdir "$current/$directory"
done
[ -d /run/gizlet/profile ] || mkdir -p /run/gizlet/profile
mount -o bind "$current" /run/gizlet/profile || { say 'cannot mount the profile'; exit 1; }
mount -o bind "$current/home" /home || { say 'cannot mount the home folder'; umount /run/gizlet/profile; exit 1; }
printf '%s\n' "$profile" > /run/gizlet/profile.id
step bound
# Gizlet runtimes are read-only SquashFS images, each mounted beside its file:
# runtime/1.sqfs at runtime/1. A runtime that fails to mount is left out.
for image in "$device"/runtime/*.sqfs; do
    [ -f "$image" ] || continue
    [ -d "${image%.sqfs}" ] || mkdir "${image%.sqfs}"
    mount -t squashfs -o ro,nodev,nosuid "$image" "${image%.sqfs}" || say "cannot mount ${image##*/}"
done
/usr/lib/gizlet/gizlet-runtime restore || say "cannot restore the selected runtime 1; using the card's runtime"
: > /run/gizlet-data.ready
step ready
