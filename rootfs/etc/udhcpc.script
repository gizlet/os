#!/bin/sh
# udhcpc event script: configures the leased address and default route, and
# shows the address on the LCD so a computer on the same network can reach it.
case "$1" in
    deconfig)
        ip -4 addr flush dev "$interface"
        ip link set "$interface" up
        rm -f "/run/gizlet-ip.$interface"
        ;;
    bound|renew)
        ip -4 addr flush dev "$interface"
        ip addr add "$ip/${mask:-24}" dev "$interface"
        ip route del default dev "$interface" 2>/dev/null
        for r in $router; do
            ip route add default via "$r" dev "$interface" && break
        done
        : > /run/resolv.conf
        for d in $dns; do echo "nameserver $d" >> /run/resolv.conf; done
        echo "$ip" > "/run/gizlet-ip.$interface"
        msg="$interface $ip, ssh root@$ip"
        echo "gizlet-net: $msg" >> /run/gizlet-boot.log
        echo "Gizlet OS: $msg" > /dev/tty1 2>/dev/null
        ;;
esac
exit 0
