load(":defs.bzl", "debian_rootfs")

package(default_visibility = ["//visibility:public"])

exports_files(["build_base.sh", "packages.lock.json"])

# Root filesystem of the build VM: Debian bookworm arm64 build tools.
debian_rootfs(
    name = "rootfs",
    bootstrap_busybox = "@debian_bookworm_arm64//:bootstrap/bin/busybox",
    debs = "@debian_bookworm_arm64//:debs",
)
