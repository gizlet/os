load(":test_toolchain.bzl", "empty_test_toolchain")

package(default_visibility = ["//visibility:public"])

# Image tests run in the build VM on the build host while the target platform
# is the AArch64 handheld. This toolchain lets any host execute them.
empty_test_toolchain(
    name = "host_test_toolchain_info",
)

toolchain(
    name = "host_test_toolchain",
    toolchain = ":host_test_toolchain_info",
    toolchain_type = "@bazel_tools//tools/test:default_test_toolchain_type",
)
