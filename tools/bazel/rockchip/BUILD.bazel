load("@rules_shell//shell:sh_test.bzl", "sh_test")

exports_files(
    ["runner.py"],
    visibility = ["//visibility:private"],
)

# Host-side unit test for the native stage runner. Like the stages themselves
# it uses the host's /usr/bin/python3. Board configurations target the
# handheld, so the test runs only in the default host configuration.
sh_test(
    name = "runner_test",
    srcs = ["runner_test.sh"],
    args = [
        "$(rootpath :runner_test.py)",
        "$(rootpath :runner.py)",
    ],
    data = [
        ":runner.py",
        ":runner_test.py",
    ],
    target_compatible_with = select({
        "//boards/gameconsole/r36s/rk3326:r36s_panel0": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)
